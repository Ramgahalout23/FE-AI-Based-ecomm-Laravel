# Production Environment Variables
# Copy this to .env.production and adjust URLs for your deployment

# Socket.io server URL — required for real-time WebSocket features
# Point this to your Node.js backend (Render, VPS, etc.)
VITE_SOCKET_URL=https://ai-based-ecomm.onrender.com

# Laravel API base URL (used by the frontend for API calls)
# If using Laravel + React on same domain, this can be empty (same-origin)
VITE_API_BASE_URL=

# Optional: Override the API v1 base path
# VITE_API_PATH=/api/v1
