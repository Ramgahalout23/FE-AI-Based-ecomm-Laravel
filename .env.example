# ── Production Environment Variables ──
# Copy this file to .env.production and fill in your values.
# NEVER commit .env.production with real values to version control.

# Backend API URL (e.g. https://your-api.com/api)
VITE_API_BASE_URL=https://your-production-api.com/api

# WebSocket server URL for real-time features (e.g. https://your-socket-server.com)
VITE_SOCKET_URL=https://your-socket-server.com
